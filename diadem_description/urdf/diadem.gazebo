<?xml version="1.0"?>
<robot name="diadem" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">

      <!-- Front pair -->
      <left_joint>FL_wheel_joint</left_joint>
      <right_joint>FR_wheel_joint</right_joint>

      <!-- Rear pair -->
      <left_joint>RL_wheel_joint</left_joint>
      <right_joint>RR_wheel_joint</right_joint>

      <wheel_separation>0.60</wheel_separation>
      <wheel_radius>0.18</wheel_radius>

      <max_linear_acceleration>5.0</max_linear_acceleration>
      <max_linear_deceleration>5.5</max_linear_deceleration>
      <max_linear_velocity>2.0</max_linear_velocity>
      <max_angular_acceleration>5.0</max_angular_acceleration>
      <max_angular_deceleration>5.5</max_angular_deceleration>
      <cmd_vel_timeout>0.5</cmd_vel_timeout>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <publish_odom_tf>false</publish_odom_tf>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- JOINT STATE PUBLISHER -->
  <gazebo>
    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
      <joint_name>FL_wheel_joint</joint_name>
      <joint_name>FR_wheel_joint</joint_name>
      <joint_name>RL_wheel_joint</joint_name>
      <joint_name>RR_wheel_joint</joint_name>
      <topic>joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <gazebo reference="lidar">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.5</min>
          <max>20.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- SURFACE FRICTION -->
  <gazebo reference="base_link">
    <collision name="base_link_collision">
      <surface>
        <friction>
          <ode>
            <mu>2.0</mu>
            <mu2>2.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <selfCollide>true</selfCollide>
    <gravity>true</gravity>
  </gazebo>

  <gazebo reference="RR_wheel_1">
    <collision name="RR_wheel_1_collision">
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.15</mu2>
            <fdir1>1 0 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <selfCollide>true</selfCollide>
  </gazebo>

  <gazebo reference="FL_wheel_1">
    <collision name="FL_wheel_1_collision">
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.15</mu2>
            <fdir1>1 0 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <selfCollide>true</selfCollide>
  </gazebo>

  <gazebo reference="RL_wheel_1">
    <collision name="RL_wheel_1_collision">
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.15</mu2>
            <fdir1>1 0 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <selfCollide>true</selfCollide>
  </gazebo>

  <gazebo reference="FR_wheel_1">
    <collision name="FR_wheel_1_collision">
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.15</mu2>
            <fdir1>1 0 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <selfCollide>true</selfCollide>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x></x>
          <y></y>
          <z></z>
        </angular_velocity>
        <linear_acceleration>
          <x></x>
          <y></y>
          <z></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
